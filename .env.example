# Proxy server port (default: 25565)
PORT=25565

# Backend Minecraft server ports
PRIMARY_PORT=25566
SECONDARY_PORT=25567

# Minecraft protocol version (default: 775)
PROTOCOL_VERSION=775
PROTOCOL_VERSION_STRING=26.1.2

# Set to 'false' to disable online mode (Mojang authentication)
ONLINE_MODE=true

# Set to '1' or set NODE_ENV=production for production mode
PRODUCTION=1

# Minecraft server heap size (default: 8G in production, 512M/256M in development)
MC_MEMORY_MAX=8G
MC_MEMORY_MIN=8G
