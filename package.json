{
  "name": "mctraveler-portal",
  "module": "main.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "PRODUCTION=1 bun --preload ./instrument.ts launcher.ts",
    "dev": "bun run launcher.ts",
    "minecraft": "bun run minecraft-server.ts",
    "minecraft:primary": "bun run minecraft-server.ts primary",
    "minecraft:secondary": "bun run minecraft-server.ts secondary",
    "proxy": "bun --preload ./instrument.ts main.ts",
    "proxy:watch": "bun --watch --preload ./instrument.ts main.ts",
    "proxy:watch:node": "node --watch --import tsx main.ts",
    "proxy:node": "node --import tsx main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "generate-packets": "bun run scripts/generate-packets.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "precommit": "bun run typecheck && bun run check && bun test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run precommit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/blessed": "^0.1.27",
    "@types/bun": "latest",
    "@types/node": "^24.12.2",
    "@types/node-forge": "^1.3.14",
    "simple-git-hooks": "^2.13.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@sentry/bun": "^10.50.0",
    "blessed": "^0.1.81",
    "dedent": "^1.7.2",
    "minecraft-data": "^3.109.0",
    "minecraft-protocol": "^1.66.0",
    "node-forge": "^1.4.0",
    "prismarine-nbt": "^2.8.0",
    "tsx": "^4.21.0"
  }
}
